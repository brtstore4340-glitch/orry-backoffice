model WithholdingTaxDocument {
  id                String           @id @default(cuid())
  documentNumber    String           @unique @map("document_number")
  status            DocumentStatus   @default(DRAFT)
  contactId         String?          @map("supplier_id")
  contact           Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  issuedAt          DateTime         @map("document_date")
  totalAmount       Decimal          @db.Decimal(12, 2) @map("tax_base_amount")
  withholdingRate   Decimal          @db.Decimal(5, 2) @map("withholding_rate")
  withholdingAmount Decimal          @db.Decimal(12, 2) @map("withheld_amount")
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  lines             WithholdingTaxLine[]

  @@map("withholding_tax_documents")
}

model WithholdingTaxLine {
  id                    String                @id @default(cuid())
  withholdingTaxDocumentId String            @map("withholding_tax_document_id")
  withholdingTaxDocument WithholdingTaxDocument @relation(fields: [withholdingTaxDocumentId], references: [id], onDelete: Cascade)
  description           String
  amount                Decimal               @db.Decimal(12, 2)
  rate                  Decimal               @db.Decimal(5, 2)
  taxAmount             Decimal               @db.Decimal(12, 2) @map("tax_amount")
  createdAt             DateTime              @default(now()) @map("created_at")

  @@map("withholding_tax_lines")
}
