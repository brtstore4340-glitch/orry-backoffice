generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  ADMIN
  SALES
  FINANCE
  OPERATIONS
  EXECUTIVE
}

enum ContactType {
  CUSTOMER
  COMPANY
  VENDOR
  PARTNER
}

enum ProductKind {
  INVENTORY
  SERVICE
  NON_INVENTORY
}

enum DocumentKind {
  PROPOSAL
  SALES_ORDER
  BILLING_RECORD
  RECEIPT
  PURCHASE_ORDER
  EXPENSE
}

enum DocumentStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  ISSUED
  FULFILLED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CREDIT_CARD
  CHEQUE
}

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

enum DocumentReferenceType {
  CONVERTED_FROM
  RELATED_TO
}

model Role {
  id    String   @id @default(cuid())
  code  RoleCode @unique
  name  String
  users User[]
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  name         String
  active       Boolean            @default(true)
  roleId       String
  role         Role               @relation(fields: [roleId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  documents    BusinessDocument[] @relation("DocumentOwner")
  payments     PaymentEntry[]     @relation("PaymentActor")
  activities   DocumentActivity[] @relation("ActivityActor")
}

model CompanyProfile {
  id              String       @id @default(cuid())
  displayName     String
  legalName       String
  legalNameEn     String?
  taxId           String?
  branchName      String?
  branchCode      String?
  vatRegistered   Boolean      @default(true)
  defaultCurrency String       @default("THB")
  phone           String?
  mobile          String?
  email           String?
  website         String?
  address         String?
  addressEn       String?
  zipCode         String?
  logoPath        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  bankAccounts    BankAccount[]
}

model BankAccount {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  bankName         String
  accountName      String
  accountNumber    String
  branch           String?
  swiftCode        String?
  isPrimary        Boolean        @default(false)
  createdAt        DateTime       @default(now())
}

model Contact {
  id            String             @id @default(cuid())
  code          String             @unique
  type          ContactType
  displayName   String
  legalName     String?
  taxId         String?
  branchName    String?
  contactPerson String?
  email         String?
  phone         String?
  mobile        String?
  address       String?
  zipCode       String?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  documents     BusinessDocument[]
}

model Warehouse {
  id        String             @id @default(cuid())
  code      String             @unique
  name      String
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  balances  InventoryBalance[]
}

model Product {
  id           String             @id @default(cuid())
  sku          String             @unique
  name         String
  kind         ProductKind
  description  String?
  barcode      String?            @unique
  unitLabel    String             @default("unit")
  unitPrice    Decimal            @db.Decimal(12, 2)
  cost         Decimal            @db.Decimal(12, 2)
  stockOnHand  Int                @default(0)
  reorderPoint Int                @default(0)
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  balances     InventoryBalance[]
  lines        DocumentLine[]
}

model InventoryBalance {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId])
}

model DocumentCounter {
  id         String       @id @default(cuid())
  kind       DocumentKind @unique
  prefix     String
  lastNumber Int          @default(0)
  updatedAt  DateTime     @updatedAt
}

model BusinessDocument {
  id                       String              @id @default(cuid())
  documentNumber           String              @unique
  kind                     DocumentKind
  status                   DocumentStatus      @default(DRAFT)
  contactId                String?
  contact                  Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId                  String?
  owner                    User?               @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  issuedAt                 DateTime
  dueAt                    DateTime?
  creditDays               Int                 @default(0)
  paymentTermLabel         String?
  salesOwnerName           String?
  projectName              String?
  referenceCode            String?
  notes                    String?
  internalNotes            String?
  taxInclusive             Boolean             @default(false)
  discountPercent          Decimal             @default(0) @db.Decimal(5, 2)
  discountAmount           Decimal             @default(0) @db.Decimal(12, 2)
  subtotalAmount           Decimal             @default(0) @db.Decimal(12, 2)
  totalAfterDiscountAmount Decimal             @default(0) @db.Decimal(12, 2)
  vatEnabled               Boolean             @default(true)
  vatAmount                Decimal             @default(0) @db.Decimal(12, 2)
  withholdingEnabled       Boolean             @default(false)
  withholdingPercent       Decimal             @default(0) @db.Decimal(5, 2)
  withholdingAmount        Decimal             @default(0) @db.Decimal(12, 2)
  deductionLabel           String?
  deductionAmount          Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount              Decimal             @default(0) @db.Decimal(12, 2)
  shareToken               String?             @unique
  sharedAt                 DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  lines                    DocumentLine[]
  payments                 PaymentEntry[]
  attachments              DocumentAttachment[]
  outgoingReferences       DocumentReference[] @relation("ReferenceSource")
  incomingReferences       DocumentReference[] @relation("ReferenceTarget")
  activities               DocumentActivity[]
}

model DocumentLine {
  id              String           @id @default(cuid())
  documentId      String
  document        BusinessDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  unitLabel       String           @default("unit")
  quantity        Decimal          @db.Decimal(12, 2)
  unitPrice       Decimal          @db.Decimal(12, 2)
  discountPercent Decimal          @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal          @default(7) @db.Decimal(5, 2)
  lineTotal       Decimal          @db.Decimal(12, 2)
  sortOrder       Int              @default(0)
}

model PaymentEntry {
  id              String           @id @default(cuid())
  documentId      String
  document        BusinessDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actorId         String?
  actor           User?            @relation("PaymentActor", fields: [actorId], references: [id], onDelete: SetNull)
  direction       PaymentDirection
  method          PaymentMethod
  amount          Decimal          @db.Decimal(12, 2)
  paidAt          DateTime
  referenceNumber String?
  note            String?
  createdAt       DateTime         @default(now())
}

model DocumentAttachment {
  id          String           @id @default(cuid())
  documentId  String
  document    BusinessDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileName    String
  storagePath String
  mimeType    String?
  fileSize    Int?
  createdAt   DateTime         @default(now())
}

model DocumentReference {
  id               String                @id @default(cuid())
  sourceDocumentId String
  sourceDocument   BusinessDocument      @relation("ReferenceSource", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  targetDocumentId String
  targetDocument   BusinessDocument      @relation("ReferenceTarget", fields: [targetDocumentId], references: [id], onDelete: Cascade)
  type             DocumentReferenceType
  createdAt        DateTime              @default(now())

  @@unique([sourceDocumentId, targetDocumentId, type])
}

model DocumentActivity {
  id         String           @id @default(cuid())
  documentId String
  document   BusinessDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?            @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  detail     String?
  createdAt  DateTime         @default(now())
}